[0.002499, "o", "\u001b[1;1H\u001b[38;5;243;48;5;235m  1 │ \u001b[38;5;252;48;5;235mTODO write the intro                                                                          \u001b[2;1H\u001b[38;5;243;48;5;235m  2 │ \u001b[38;5;252;48;5;235mKyte starts in plain insert mode, like Nano.                                                  \u001b[3;1H\u001b[38;5;243;48;5;235m  3 │ \u001b[38;5;252;48;5;235mArrows move, typing types, Ctrl-S saves.                                                      \u001b[4;1H\u001b[38;5;243;48;5;235m  4 │ \u001b[38;5;252;48;5;235mPress Esc for the one-key operator layer.                                                     \u001b[5;1H\u001b[38;5;243;48;5;235m  5 │ \u001b[38;5;252;48;5;235m  w deletes a word, d a line, k to end of line.                                               \u001b[6;1H\u001b[38;5;243;48;5;235m  6 │ \u001b[38;5;252;48;5;235mPress Esc twice for the command palette.                                                      \u001b[7;1H\u001b[38;5;243;48;5;235m  7 │ \u001b[38;5;252;48;5;235mfn bracket_demo(x: [u8; 4]) -> u8 {                                                           \u001b[8;1H\u001b[38;5;243;48;5;235m  8 │ \u001b[38;5;252;48;5;235m    x[0] + (x[1] * x[2])                                                                      \u001b[9;1H\u001b[38;5;243;48;5;235m  9 │ \u001b[38;5;252;48;5;235m}                                                                                             \u001b[10;1H\u001b[38;5;243;48;5;235m 10 │ \u001b[38;5;252;48;5;235mUnsaved work is written to a swap file,                                                       \u001b[11;1H\u001b[38;5;243;48;5;235m 11 │ \u001b[38;5;252;48;5;235mso a crash never loses your edits.                                                            \u001b[12;1H\u001b[38;5;243;48;5;235m 12 │ \u001b[38;5;252;48;5;235mTry the palette: Go to line, Find, Save.                                                      \u001b[13;1H\u001b[38;5;243;48;5;235m 13 │ \u001